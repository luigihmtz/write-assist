{
  "file": "settings.json",
  "description": "Default settings for Write Assist, shipped with the app and replaced on update. Per-user changes go in %APPDATA%\\WriteAssist\\user_settings.json (same keys), which overrides these.",
  "author": "Luis Martinez",
  "email": "16788942+luigihmtz@users.noreply.github.com",
  "version": "v02.08.00",
  "date": "2026-11-25",

  "hotkey": "Win+Ctrl+W",
  "ui_language": "",

  "speech_model": "small",
  "speech_language": "",
  "microphone": "",
  "check_mode": "spelling",

  "default_provider": "",
  "auto_fallback": true,
  "providers": {
    "Local (free)": {
      "type": "ollama",
      "path": "",
      "models": ["gemma3:4b", "gemma3:12b"],
      "default_model": "gemma3:4b",
      "timeout_seconds": 300
    },
    "Claude": {
      "type": "claude",
      "path": "",
      "models": ["haiku", "sonnet", "opus"],
      "default_model": "haiku",
      "effort": "low"
    },
    "ChatGPT": {
      "type": "codex",
      "path": "",
      "models": ["gpt-6-luna", "gpt-5.6-terra"],
      "default_model": "gpt-6-luna",
      "effort": "low"
    },
    "GitHub Copilot": {
      "type": "copilot",
      "path": "",
      "models": ["auto"],
      "default_model": "auto",
      "effort": ""
    }
  },

  "timeout_seconds": 120,
  "font_size": 11,
  "auto_copy": false,
  "prompt_presets": [
    "Casual chat message to a friend",
    "Work Slack/Teams message to a colleague",
    "Email to a client",
    "Formal email",
    "Social media post",
    "Documentation / README"
  ]
}
