{
  "file": "settings.json",
  "description": "Default settings for Write Assist, shipped with the app and replaced on update. Per-user changes go in %APPDATA%\\WriteAssist\\user_settings.json (same keys), which overrides these.",
  "author": "Luis Martinez",
  "email": "luis@luigi.mx",
  "version": "v01.05.00",
  "date": "2026-11-24",

  "hotkey": "Win+Ctrl+W",

  "default_provider": "Claude",
  "providers": {
    "Claude": {
      "type": "claude",
      "path": "",
      "models": ["opus", "sonnet", "haiku"],
      "default_model": "opus",
      "effort": "low"
    },
    "GitHub Copilot": {
      "type": "copilot",
      "path": "",
      "models": ["auto"],
      "default_model": "auto",
      "effort": ""
    }
  },

  "timeout_seconds": 120,
  "font_family": "Segoe UI",
  "font_size": 11,
  "auto_copy": false,
  "prompt_presets": [
    "Casual chat message to a friend",
    "Work Slack/Teams message to a colleague",
    "Email to a client",
    "Formal email",
    "Social media post",
    "Documentation / README"
  ]
}
